apiVersion: apps/v1
kind: Deployment
metadata:
  name: fl-client-silo-{{ silo_id }}
  namespace: digitafrica
  labels:
    app: fl-client-silo
    digitafrica.org/silo-id: "{{ silo_id }}"
    digitafrica.org/group-id: "{{ group_id }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fl-client-silo
      digitafrica.org/silo-id: "{{ silo_id }}"
  template:
    metadata:
      labels:
        app: fl-client-silo
        digitafrica.org/silo-id: "{{ silo_id }}"
        digitafrica.org/group-id: "{{ group_id }}"
    spec:
      nodeSelector:
        kubernetes.io/hostname: "{{ client_vm }}"
      containers:
      - name: client
        image: python:3.13.5-slim
        imagePullPolicy: IfNotPresent
        env:
        - name: PYTHONUNBUFFERED
          value: "1"
        - name: GROUP_ID
          value: "{{ group_id }}"
        - name: FLOWER_SERVER_ADDRESS
          value: "{{ flower_server_address }}"
        - name: CLIENT_DATA_PATH
          value: "/workspace/data/train.csv"
        - name: NUM_CLASSES
          value: "5"
        - name: SYNTHETIC_FEATURE_DIM
          value: "16"
        - name: SYNTHETIC_SEED
          value: "42"
        - name: LEARNING_RATE
          value: "0.1"
        - name: LOCAL_EPOCHS
          value: "1"
        command: ["/bin/sh", "-c"]
        args:
          - |
            set -eu
            python -m pip install \
              --disable-pip-version-check \
              --no-cache-dir \
              --requirement /workspace/app/requirements.lock

            if [ ! -f /state/workflow-complete ]; then
              echo "Starting {{ group_id }} workflow-demo client."
              until python /workspace/app/client/client.py; do
                echo "Flower server is unavailable; retrying in 10 seconds."
                sleep 10
              done
              touch /state/workflow-complete
              echo "{{ group_id }} workflow-demo client completed."
            fi

            exec sleep infinity
        volumeMounts:
        - name: workspace-volume
          mountPath: /workspace
          readOnly: true
        - name: state-volume
          mountPath: /state
      volumes:
      - name: workspace-volume
        hostPath:
          path: "{{ fl_silo_runtime_root }}"
          type: Directory
      - name: state-volume
        emptyDir: {}

{% set workshop_groups = [] %}
{% for _worker in fl_workshop_client_hosts %}
{% set _ = workshop_groups.append('group_%02d' | format(loop.index)) %}
{% endfor %}
{% set jupyterhub_admin_users = digitafrica_deployment.jupyterhub.jupyterhub_admin_users | default([]) %}
{% set jupyterhub_legacy_allowed_users = (workshop_groups + jupyterhub_admin_users) | unique | list %}
{% set workshop_group_nodes = {} %}
{% for _worker in fl_workshop_client_hosts %}
{% set _group_name = 'group_%02d' | format(loop.index) %}
{% set _node_name = hostvars[_worker].ansible_fqdn %}
{% set _ = workshop_group_nodes.update({_group_name: _node_name}) %}
{% endfor %}
{% set flower_server_host = groups[fl_workshop_server_group][0] %}
{% set flower_server_address = (hostvars[flower_server_host].ansible_host | default(flower_server_host)) ~ ':8080' %}
{% set jupyterhub_control_node = hostvars[flower_server_host].ansible_fqdn | default(flower_server_host) %}
{% set jhub_host = digitafrica_deployment.jupyterhub.jupyterhub_public_url | urlsplit('hostname') %}
{% set identity_config = digitafrica_deployment.identity | default({}) %}
{% set keycloak_host = identity_config.keycloak_public_url | default('') | urlsplit('hostname') %}
{% set jupyterhub_reuses_keycloak_tls = (
  (oidc.oidc_enabled | default(false) | bool)
  and (digitafrica_deployment.tls_mode | default('none') in ['letsencrypt', 'provided'])
  and jhub_host == keycloak_host
) %}
proxy:
  service:
{% if digitafrica_deployment.expose_mode == 'ingress' %}
    type: ClusterIP
{% else %}
    type: NodePort
    nodePorts:
      http: {{ digitafrica_deployment.jupyterhub.jupyter_nodeport }}
{% endif %}

ingress:
{% if digitafrica_deployment.expose_mode == 'ingress' %}
  enabled: true
  annotations:
    kubernetes.io/ingress.class: traefik
    traefik.ingress.kubernetes.io/router.middlewares: "{{ digitafrica_deployment.digitafrica_namespace }}-jupyterhub-redirect-slash@kubernetescrd"
{% if digitafrica_deployment.tls_mode | default('none') != 'none' %}
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
{% if digitafrica_deployment.tls_mode | default('none') == 'letsencrypt' and not jupyterhub_reuses_keycloak_tls %}
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
{% endif %}
{% endif %}
{% if jhub_host | regex_search('^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$') %}
  # Host is a raw IP — omit hosts field so Traefik matches all incoming requests
{% else %}
  hosts:
    - {{ jhub_host }}
{% endif %}
{% if digitafrica_deployment.tls_mode | default('none') != 'none' %}
  tls:
    - secretName: jhub-tls
{% if digitafrica_deployment.tls_mode | default('none') == 'letsencrypt' and not (jhub_host | regex_search('^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')) %}
      hosts:
        - {{ jhub_host }}
{% endif %}
{% endif %}
{% else %}
  enabled: false
{% endif %}

hub:
{% if oidc.oidc_enabled %}
  # The confidential client secret is never rendered into Helm values.
  # It is mounted from the applications-phase Kubernetes Secret instead.
  extraVolumes:
    - name: digitafrica-jupyterhub-oidc
      secret:
        secretName: jupyterhub-oidc
        items:
          - key: client-secret
            path: client-secret

  extraVolumeMounts:
    - name: digitafrica-jupyterhub-oidc
      mountPath: /etc/digitafrica/oidc
      readOnly: true
{% endif %}

  # Hub retains Kubernetes' existing placement because its SQLite database uses
  # a node-local PVC. Group notebook kernels are placed separately on their
  # assigned client VMs by the pre-spawn hook below.
  baseUrl: /jupyter

  # Recheck the participant PVC on every spawn. This permits a workshop reset
  # to remove workspace claims without leaving stale KubeSpawner PVC state.
  config:
    KubeSpawner:
      remember_pvc_name: false

  extraConfig:
{% if oidc.oidc_enabled %}
    05-digitafrica-oidc-secret: |
      from pathlib import Path

      oidc_secret_file = Path("/etc/digitafrica/oidc/client-secret")
      if not oidc_secret_file.is_file():
          raise RuntimeError(
              "The required jupyterhub-oidc Kubernetes Secret is not mounted."
          )

      c.GenericOAuthenticator.client_secret = (
          oidc_secret_file.read_text(encoding="utf-8").strip()
      )
{% endif %}
    10-digitafrica-group-workspace: |
      # This mapping is generated from the ordered worker inventory.
      # Keycloak group membership, rather than the account username, selects
      # the permitted local workshop directory and worker placement.
      WORKSHOP_GROUP_NODES = {{ workshop_group_nodes | to_json }}
      WORKSHOP_ADMIN_USERS = {{ jupyterhub_admin_users | to_json }}
      OIDC_ENABLED = {{ 'True' if (oidc.oidc_enabled | bool) else 'False' }}
      WORKSHOP_HOST_PATH = "/opt/digitafrica/fl-workshop"
      WORKSHOP_MOUNT_PATH = "/home/jovyan/digitafrica/workshop"

      # Do not retain a removed participant PVC name in the Hub database.
      # Ensure the dynamic home PVC exists before KubeSpawner creates the Pod.
      c.KubeSpawner.remember_pvc_name = False
      c.KubeSpawner.storage_pvc_ensure = True

      async def configure_digitafrica_group_workspace(spawner):
          username = spawner.user.name.lower()
          if OIDC_ENABLED:
              user_group_names = {
                  group.name.lower()
                  for group in (spawner.user.groups or [])
              }
              assigned_groups = sorted(
                  group_name
                  for group_name in user_group_names
                  if group_name in WORKSHOP_GROUP_NODES
              )

              if len(assigned_groups) == 0:
                  if username in WORKSHOP_ADMIN_USERS:
                      return
                  raise RuntimeError(
                      "No workshop group is assigned to this account."
                  )
              if len(assigned_groups) != 1:
                  raise RuntimeError(
                      "Each workshop participant must have exactly one "
                      "workshop group assignment."
                  )
              group_id = assigned_groups[0]
          else:
              # Deprecated compatibility path for non-OIDC regression tests.
              group_id = username

          assigned_node = WORKSHOP_GROUP_NODES.get(group_id)

          # Administrators may use JupyterHub but do not receive a student
          # partition or a client-VM placement.
          if assigned_node is None:
              return

          node_selector = dict(spawner.node_selector or {})
          node_selector["kubernetes.io/hostname"] = assigned_node
          spawner.node_selector = node_selector

          volume_name = "digitafrica-workshop"
          volumes = {
              key: volume
              for key, volume in dict(spawner.volumes or {}).items()
              if volume.get("name") != volume_name
          }
          volumes[volume_name] = {
              "name": volume_name,
              "hostPath": {
                  "path": WORKSHOP_HOST_PATH,
                  "type": "Directory",
              },
          }
          spawner.volumes = volumes

          volume_mounts = {
              key: mount
              for key, mount in dict(spawner.volume_mounts or {}).items()
              if mount.get("name") != volume_name
          }
          volume_mounts[volume_name] = {
              "name": volume_name,
              "mountPath": WORKSHOP_MOUNT_PATH,
              "readOnly": True,
          }
          spawner.volume_mounts = volume_mounts

          environment = dict(spawner.environment or {})
          environment["GROUP_ID"] = group_id
          spawner.environment = environment

      c.KubeSpawner.pre_spawn_hook = configure_digitafrica_group_workspace

  config:
    JupyterHub:
{% if oidc.oidc_enabled %}
      authenticator_class: generic-oauth
{% else %}
      authenticator_class: dummy
{% endif %}

{% if oidc.oidc_enabled %}
    GenericOAuthenticator:
      client_id: "{{ oidc.oidc_client_id }}"
      authorize_url: "{{ oidc.oidc_issuer_url.rstrip('/') }}/protocol/openid-connect/auth"
      token_url: "{{ oidc.oidc_issuer_url.rstrip('/') }}/protocol/openid-connect/token"
      userdata_url: "{{ oidc.oidc_issuer_url.rstrip('/') }}/protocol/openid-connect/userinfo"
      scope: {{ oidc.oidc_scope | to_json }}
      username_claim: "{{ oidc.oidc_username_claim }}"
      tls_verify: {{ oidc.oidc_tls_verify | default(true) | to_json }}
      manage_groups: true
      auth_state_groups_key: "oauth_user.{{ oidc.oidc_groups_claim | default('groups') }}"
      oauth_callback_url: "{{ digitafrica_deployment.jupyterhub.jupyterhub_public_url.rstrip('/') }}/hub/oauth_callback"

{% endif %}
    Authenticator:
      allow_all: false
{% if oidc.oidc_enabled %}
      auto_login: true
      allowed_users: {{ jupyterhub_admin_users | to_json }}
      allowed_groups: {{ workshop_groups | to_json }}
{% else %}
      # Deprecated compatibility path for non-OIDC regression tests.
      allowed_users: {{ jupyterhub_legacy_allowed_users | to_json }}
{% endif %}
      admin_users: {{ jupyterhub_admin_users | to_json }}

singleuser:
  image:
{% if workshop_notebook_runtime.enabled | default(false) | bool %}
    name: {{ workshop_notebook_runtime.image_name }}
    tag: "{{ workshop_notebook_runtime.image_tag }}"
{% else %}
    name: jupyter/minimal-notebook
    tag: "python-3.11"
{% endif %}
  defaultUrl: "/lab"

  cpu:
    limit: 2
  memory:
    limit: 2G

  extraEnv:
    MLFLOW_TRACKING_URI: "https://mlflow.digitafrica.eu"
    FLOWER_SERVER_ADDRESS: "{{ flower_server_address }}"
    DIGITAFRICA_WORKSHOP_ROOT: "/home/jovyan/digitafrica/workshop"
    CLIENT_DATA_PATH: "/home/jovyan/digitafrica/workshop/data/train.csv"

  # Important for first spawn on k3s local-path (image pulls + PVC provisioning)
  startTimeout: 900

  storage:
    type: dynamic
    capacity: 10Gi
    dynamic:
      storageClass: {{ digitafrica_deployment.jupyterhub.storage_class }}
      volumeNameTemplate: home   # keeps the home PVC volume named "home" so the chart can inject it into initContainers

    # Tutorial sources are read-only ConfigMaps. Only beginner assets remain
    # mounted in the regular notebook container for backwards compatibility.
    # Advanced assets, solutions, and organiser state are init-container-only.
    extraVolumes:
      - name: digitafrica-seed-beginner
        configMap:
          name: digitafrica-notebooks-beginner
      - name: digitafrica-seed-advanced
        configMap:
          name: digitafrica-notebooks-advanced
      - name: digitafrica-seed-solutions
        configMap:
          name: digitafrica-notebooks-solutions
      - name: digitafrica-workshop-state
        configMap:
          name: digitafrica-workshop-state
      - name: digitafrica-seed-introduction-to-ai-module1
        configMap:
          name: digitafrica-introduction-to-ai-module1
      # Module 2 has guided beginner, advanced TODO, and protected solution tracks.
      - name: digitafrica-seed-introduction-to-ai-module2-beginner
        configMap:
          name: digitafrica-notebooks-introduction-to-ai-module2-beginner
      - name: digitafrica-seed-introduction-to-ai-module2-advanced
        configMap:
          name: digitafrica-notebooks-introduction-to-ai-module2-advanced
      - name: digitafrica-seed-introduction-to-ai-module2-solutions
        configMap:
          name: digitafrica-notebooks-introduction-to-ai-module2-solutions
{% if workshop_notebook_runtime.enabled | default(false) | bool %}
      - name: digitafrica-runtime-requirements
        configMap:
          name: digitafrica-runtime-requirements
{% endif %}

    extraVolumeMounts:
      - name: digitafrica-seed-beginner
        mountPath: /seed
        readOnly: true

  initContainers:
{% if workshop_notebook_runtime.enabled | default(false) | bool %}
    # Install once per group PVC, before the participant reaches JupyterLab.
    # The marker ties the cached environment to the exact locked requirements.
    - name: prepare-workshop-runtime
      image: {{ workshop_notebook_runtime.image_name }}:{{ workshop_notebook_runtime.image_tag }}
      command: ["bash", "-lc"]
      args:
        - |
          set -euo pipefail
          requirements=/runtime/requirements.lock
          runtime_dir=/home/jovyan/.local/share/digitafrica
          marker="$runtime_dir/requirements.sha256"
          expected="$(sha256sum "$requirements" | cut -d " " -f1)"

          if [ "$(cat "$marker" 2>/dev/null || true)" != "$expected" ]; then
            echo "[runtime] Installing locked workshop dependencies."
            python -m pip install --user --no-cache-dir --requirement "$requirements"
            mkdir -p "$runtime_dir"
            printf "%s\n" "$expected" > "$marker"
          else
            echo "[runtime] Locked workshop dependencies are already available."
          fi

          python -c "import flwr, numpy, pandas, sklearn; print('[runtime] Flower', flwr.__version__, 'is ready.')"
      volumeMounts:
        - name: digitafrica-runtime-requirements
          mountPath: /runtime
          readOnly: true
        - name: home
          mountPath: /home/jovyan
{% endif %}
    - name: seed-notebooks
      image: alpine:3.20
      command: ["sh", "-lc"]
      args:
        - |
          set -eu

          workspace=/home/jovyan/digitafrica
          beginner_source=/seed/beginner
          advanced_source=/seed/advanced
          solutions_source=/seed/solutions
          module1_source=/seed/introduction-to-ai/module1
          module1_parent=/home/jovyan/Introduction-to-AI
          module1_workspace="$module1_parent/Module-1"
          module1_notebook=01_symbolic_ai_tutorial.ipynb
          module2_beginner_source=/seed/introduction-to-ai/module2/beginner
          module2_advanced_source=/seed/introduction-to-ai/module2/advanced
          module2_solutions_source=/seed/introduction-to-ai/module2/solutions
          module2_parent=/home/jovyan/Introduction-to-AI
          module2_workspace="$module2_parent/Module-2"
          module2_beginner_workspace="$module2_workspace/beginner"
          module2_advanced_workspace="$module2_workspace/advanced"
          module2_solutions_workspace="$module2_workspace/solutions"
          module2_beginner_notebook=02_foundations_of_ml_beginner.ipynb
          module2_advanced_notebook=02_foundations_of_ml_advanced.ipynb
          module2_solutions_notebook=02_foundations_of_ml_solutions.ipynb
          state_dir=/state

          workshop_type="$(tr -d '\r\n' < "$state_dir/workshop_type")"
          mode="$(tr -d '\r\n' < "$state_dir/mode")"
          solutions_released="$(tr -d '\r\n' < "$state_dir/solutions_released")"
          if [ -f "$state_dir/introduction_to_ai_module" ]; then
            introduction_to_ai_module="$(
              tr -d '\r\n' < "$state_dir/introduction_to_ai_module"
            )"
          else
            # Existing ConfigMaps predate the selector; preserve Module 1 behaviour.
            introduction_to_ai_module=module1
          fi

          case "$workshop_type" in
            none|introduction-to-ai|federated-learning) ;;
            *)
              echo "[seed] ERROR: unsupported workshop type: $workshop_type" >&2
              exit 1
              ;;
          esac

          case "$introduction_to_ai_module" in
            module1|module2) ;;
            *)
              echo "[seed] ERROR: unsupported Introduction to AI module: $introduction_to_ai_module" >&2
              exit 1
              ;;
          esac

          if [ "$workshop_type" = "federated-learning" ]; then
            case "$mode" in
              beginner|advanced) ;;
              *)
                echo "[seed] ERROR: unsupported workshop mode: $mode" >&2
                exit 1
                ;;
            esac

            case "$solutions_released" in
              true|false) ;;
              *)
                echo "[seed] ERROR: invalid solutions_released state: $solutions_released" >&2
                exit 1
                ;;
            esac
          fi

          copy_seed_file() {{ '{{' }}
            source_file="$1"
            destination_file="$2"
            overwrite="$3"

            if [ ! -f "$source_file" ]; then
              echo "[seed] ERROR: missing required seed file: $source_file" >&2
              exit 1
            fi

            if [ "$overwrite" = "false" ] && [ -e "$destination_file" ]; then
              echo "[seed] preserving existing file: $destination_file"
              return 0
            fi

            rm -f "$destination_file"
            cp -L "$source_file" "$destination_file"
            chown 1000:100 "$destination_file"
            chmod 0644 "$destination_file"
          }}

          write_receipt_if_absent() {{ '{{' }}
            receipt="$1"
            provenance_file="$2"

            if [ -e "$receipt" ]; then
              return 0
            fi

            (
              printf "seeded_at_utc=%s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
              printf "provenance_file=%s\n" "$provenance_file"
            ) > "$receipt"
            chown 1000:100 "$receipt"
            chmod 0644 "$receipt"
          }}

          mkdir -p "$workspace"

          if [ "$workshop_type" = "federated-learning" ]; then
          if [ "$mode" = "beginner" ]; then
            # Preserve the established beginner behaviour: only these managed
            # files at the workspace root are refreshed on each spawn.
            rm -f \
              "$workspace/01_Group_Workspace.ipynb" \
              "$workspace/01_precision_agriculture_edge_ml.ipynb" \
              "$workspace/02_ml_basics_training_vs_inference.ipynb" \
              "$workspace/requirements.txt" \
              "$workspace/..data"

            for filename in \
              00_START_HERE.md \
              01_Inspect_Local_Partition.ipynb \
              02_Run_Federated_Client.ipynb \
              WORKSHOP_VERSION.json; do
              copy_seed_file "$beginner_source/$filename" "$workspace/$filename" true
            done

            (
              printf "seeded_at_utc=%s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
              printf "provenance_file=WORKSHOP_VERSION.json\n"
            ) > "$workspace/WORKSHOP_SEED_RECEIPT.txt"
            chown 1000:100 "$workspace/WORKSHOP_SEED_RECEIPT.txt"
            chmod 0644 "$workspace/WORKSHOP_SEED_RECEIPT.txt"
          else
            # Mode changes cannot replace beginner work or participant files.
            advanced_workspace="$workspace/advanced"
            mkdir -p "$advanced_workspace"

            for filename in \
              00_START_HERE.md \
              01_Inspect_Local_Partition.ipynb \
              02_Run_Federated_Client.ipynb \
              WORKSHOP_VERSION.json; do
              copy_seed_file "$advanced_source/$filename" \
                "$advanced_workspace/$filename" false
            done

            write_receipt_if_absent \
              "$advanced_workspace/WORKSHOP_SEED_RECEIPT.txt" \
              "WORKSHOP_VERSION.json"
          fi

          if [ "$solutions_released" = "true" ]; then
            solutions_workspace="$workspace/reference-solutions"
            mkdir -p "$solutions_workspace"

            for filename in \
              01_Inspect_Local_Partition_solution.ipynb \
              02_Run_Federated_Client_solution.ipynb \
              WORKSHOP_VERSION.json; do
              copy_seed_file "$solutions_source/$filename" \
                "$solutions_workspace/$filename" false
            done

            write_receipt_if_absent \
              "$solutions_workspace/SOLUTIONS_RELEASE_RECEIPT.txt" \
              "WORKSHOP_VERSION.json"
          fi
          fi

          # Module 1 is copied only for an active Introduction to AI workshop
          # and only when a participant does not already have a personal copy.
          if [ "$workshop_type" = "introduction-to-ai" ] && \
             [ "$introduction_to_ai_module" = "module1" ] && \
             [ -f "$module1_source/$module1_notebook" ]; then
            mkdir -p "$module1_workspace"
            chown 1000:100 "$module1_parent" "$module1_workspace"
            chmod 0755 "$module1_parent" "$module1_workspace"

            copy_seed_file \
              "$module1_source/$module1_notebook" \
              "$module1_workspace/$module1_notebook" \
              false

            write_receipt_if_absent \
              "$module1_workspace/MODULE1_SEED_RECEIPT.txt" \
              "$module1_notebook"
          fi

          # Module 2 always provides the guided beginner and advanced TODO tracks.
          # Reference solutions are copied only after an explicit organiser release.
          if [ "$workshop_type" = "introduction-to-ai" ] && \
             [ "$introduction_to_ai_module" = "module2" ]; then
            if [ "$mode" != "advanced" ]; then
              echo "[seed] ERROR: Module 2 requires mode=advanced" >&2
              exit 1
            fi

            mkdir -p "$module2_beginner_workspace" "$module2_advanced_workspace"
            chown 1000:100 \
              "$module2_parent" \
              "$module2_workspace" \
              "$module2_beginner_workspace" \
              "$module2_advanced_workspace"
            chmod 0755 \
              "$module2_parent" \
              "$module2_workspace" \
              "$module2_beginner_workspace" \
              "$module2_advanced_workspace"

            copy_seed_file \
              "$module2_beginner_source/$module2_beginner_notebook" \
              "$module2_beginner_workspace/$module2_beginner_notebook" \
              false
            write_receipt_if_absent \
              "$module2_beginner_workspace/MODULE2_BEGINNER_SEED_RECEIPT.txt" \
              "$module2_beginner_notebook"

            copy_seed_file \
              "$module2_advanced_source/$module2_advanced_notebook" \
              "$module2_advanced_workspace/$module2_advanced_notebook" \
              false
            write_receipt_if_absent \
              "$module2_advanced_workspace/MODULE2_ADVANCED_SEED_RECEIPT.txt" \
              "$module2_advanced_notebook"

            if [ "$solutions_released" = "true" ]; then
              mkdir -p "$module2_solutions_workspace"
              chown 1000:100 "$module2_solutions_workspace"
              chmod 0755 "$module2_solutions_workspace"

              copy_seed_file \
                "$module2_solutions_source/$module2_solutions_notebook" \
                "$module2_solutions_workspace/$module2_solutions_notebook" \
                false
              write_receipt_if_absent \
                "$module2_solutions_workspace/MODULE2_SOLUTIONS_RELEASE_RECEIPT.txt" \
                "$module2_solutions_notebook"
            fi
          fi

          echo "[seed] workshop type: $workshop_type"
          echo "[seed] Introduction to AI module: $introduction_to_ai_module"
          echo "[seed] workshop mode: $mode"
          echo "[seed] solutions released: $solutions_released"
      volumeMounts:
        - name: digitafrica-seed-beginner
          mountPath: /seed/beginner
          readOnly: true
        - name: digitafrica-seed-advanced
          mountPath: /seed/advanced
          readOnly: true
        - name: digitafrica-seed-solutions
          mountPath: /seed/solutions
          readOnly: true
        - name: digitafrica-workshop-state
          mountPath: /state
          readOnly: true
        - name: digitafrica-seed-introduction-to-ai-module1
          mountPath: /seed/introduction-to-ai/module1
          readOnly: true
        - name: digitafrica-seed-introduction-to-ai-module2-beginner
          mountPath: /seed/introduction-to-ai/module2/beginner
          readOnly: true
        - name: digitafrica-seed-introduction-to-ai-module2-advanced
          mountPath: /seed/introduction-to-ai/module2/advanced
          readOnly: true
        - name: digitafrica-seed-introduction-to-ai-module2-solutions
          mountPath: /seed/introduction-to-ai/module2/solutions
          readOnly: true
        # This is the user PVC mount, made predictable via volumeNameTemplate: home.
        - name: home
          mountPath: /home/jovyan

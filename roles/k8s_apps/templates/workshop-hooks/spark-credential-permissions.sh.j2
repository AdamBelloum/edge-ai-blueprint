# Run only in the Spark participant seed branch, after the home PVC mounts.
# Restore existing credentials; never create, replace or display key material.
spark_credential_uid=1000
spark_ssh_directory=/home/jovyan/.ssh
spark_credentials_directory="$spark_ssh_directory/spark-direct"

if [ -L "$spark_ssh_directory" ]; then
  echo "[spark-credentials] ERROR: SSH directory symlink refused." >&2
  exit 1
fi

if [ -e "$spark_credentials_directory" ] || [ -L "$spark_credentials_directory" ]; then
  # Complete preflight before changing any permissions.
  for directory in "$spark_ssh_directory" "$spark_credentials_directory"; do
    if [ -L "$directory" ] || [ ! -d "$directory" ] ||
       [ "$(stat -c %u "$directory")" != "$spark_credential_uid" ]; then
      echo "[spark-credentials] ERROR: unsafe directory type or ownership." >&2
      exit 1
    fi
  done
  for filename in login_key known_hosts; do
    credential="$spark_credentials_directory/$filename"
    if [ -L "$credential" ] || [ ! -f "$credential" ] ||
       [ "$(stat -c %u "$credential")" != "$spark_credential_uid" ] ||
       [ "$(stat -c %h "$credential")" != "1" ]; then
      echo "[spark-credentials] ERROR: missing or unsafe $filename." >&2
      exit 1
    fi
  done

  # No recursive chmod/chown and no modification of other SSH files.
  for directory in "$spark_ssh_directory" "$spark_credentials_directory"; do
    chmod 0700 "$directory"
    chmod u-s,g-s,o-t "$directory"
    if [ "$(stat -c %a "$directory")" != "700" ]; then
      echo "[spark-credentials] ERROR: private directory mode not established." >&2
      exit 1
    fi
  done
  for filename in login_key known_hosts; do
    credential="$spark_credentials_directory/$filename"
    chmod 0600 "$credential"
    if [ "$(stat -c %a "$credential")" != "600" ]; then
      echo "[spark-credentials] ERROR: private $filename mode not established." >&2
      exit 1
    fi
  done
  echo "[spark-credentials] Existing credential permissions restored."
else
  # Teaching-asset publication does not provision participant credentials.
  # Leave missing credentials absent; the launcher still fails closed.
  echo "[spark-credentials] Credentials not provisioned; permission repair skipped."
fi

      SPARK_DIRECT_CREDENTIALS_ENABLED = {{ 'True' if ((big_data_spark_credentials_enabled | default(false) | bool) and not (workshop_reset_neutral | default(false) | bool)) else 'False' }}
      SPARK_DIRECT_INIT = "digitafrica-spark-credentials"
      SPARK_DIRECT_HOME_INIT = "digitafrica-spark-home"
      SPARK_DIRECT_HOME_SCRIPT = "\n".join([
          "set -eu",
          'workshop_type=""',
          'read -r workshop_type < /state/workshop_type || [ -n "$workshop_type" ] || true',
          'if [ "$workshop_type" != "big-data" ]; then',
          '  echo "[spark-home] Spark is inactive; home preparation skipped."',
          '  exit 0',
          'fi',
          'if [ "$(stat -c %u /home/jovyan)" != "1000" ]; then',
          '  chown 1000:100 /home/jovyan',
          'fi',
          'chmod u+rwx /home/jovyan',
      ])
      SPARK_DIRECT_SOURCE = "digitafrica-spark-direct-source"
      SPARK_DIRECT_CODE = "digitafrica-spark-direct-code"
      SPARK_DIRECT_BOOTSTRAP = '\nimport io, json, os, runpy, sys\nfrom pathlib import Path\ntry:\n    if Path("/state/workshop_type").read_text().strip() != "big-data":\n        print("[spark-credentials] Inactive workshop; skipped.")\n        raise SystemExit(0)\n    source = Path("/run/spark-direct-source/request.json")\n    helper = Path("/run/spark-direct-code/reconcile_credentials.py")\n    if not source.is_file() or not helper.is_file():\n        print("[spark-credentials] Staged credentials/helper missing; organiser reconciliation required.")\n        raise SystemExit(2)\n    raw = source.read_text()\n    if len(raw) > 131072:\n        raise ValueError("oversized request")\n    request = json.loads(raw)\n    expected_node = os.environ["DIGITAFRICA_SPARK_EXPECTED_NODE"]\n    if (request.get("group_id") != os.environ["GROUP_ID"]\n            or request.get("worker_node") != expected_node\n            or os.environ["DIGITAFRICA_SPARK_POD_NODE"] != expected_node\n            or request.get("operation") != "apply"):\n        print("[spark-credentials] Group/node binding mismatch; no workspace changes.")\n        raise SystemExit(2)\n    sys.stdin = io.StringIO(raw)\n    sys.argv = [str(helper)]\n    runpy.run_path(str(helper), run_name="__main__")\nexcept Exception:\n    print("[spark-credentials] Startup validation failed; payload is not logged.")\n    raise SystemExit(2)\n'

      def clear_digitafrica_spark_credentials(spawner):
          containers = [digitafrica_container_to_api(item)
                        for item in deepcopy(list(spawner.init_containers or []))]
          spawner.init_containers = [
              item for item in containers if item.get("name") not in (SPARK_DIRECT_INIT, SPARK_DIRECT_HOME_INIT)
          ]
          managed = {SPARK_DIRECT_SOURCE, SPARK_DIRECT_CODE}
          for attribute in ("volumes", "volume_mounts"):
              values = deepcopy(dict(getattr(spawner, attribute, None) or {}))
              setattr(spawner, attribute, {
                  key: value for key, value in values.items()
                  if value.get("name") not in managed
              })

      def configure_digitafrica_spark_credentials(spawner, group_id):
          if not SPARK_DIRECT_CREDENTIALS_ENABLED:
              return
          node = WORKSHOP_GROUP_NODES.get(group_id)
          if not node or spawner.environment.get("GROUP_ID") != group_id:
              raise RuntimeError("Spark credentials require an authorised group.")
          image = getattr(spawner, "image", None)
          if not isinstance(image, str) or not image.strip():
              raise RuntimeError("Spark credential delivery requires a notebook image.")
          if getattr(spawner, "fs_gid", 100) != 100:
              raise RuntimeError("Spark credential delivery requires notebook fs_gid=100.")
          volumes = deepcopy(dict(spawner.volumes or {}))
          volumes[SPARK_DIRECT_SOURCE] = {
              "name": SPARK_DIRECT_SOURCE,
              "secret": {
                  "secretName": "digitafrica-spark-direct-" + group_id.replace("_", "-"),
                  "defaultMode": 288, "optional": True,
                  "items": [{"key": "request.json", "path": "request.json"}],
              },
          }
          volumes[SPARK_DIRECT_CODE] = {
              "name": SPARK_DIRECT_CODE,
              "configMap": {
                  "name": "digitafrica-spark-credential-code", "optional": True,
                  "items": [{"key": "reconcile_credentials.py", "path": "reconcile_credentials.py"}],
              },
          }
          containers = deepcopy(list(spawner.init_containers or []))
          # Prepare only the PVC root (non-recursive); skipped unless Spark is active.
          containers.append({
              "name": SPARK_DIRECT_HOME_INIT,
              "image": "alpine:3.20",
              "securityContext": {
                  "runAsUser": 0, "runAsGroup": 0, "runAsNonRoot": False,
                  "allowPrivilegeEscalation": False, "readOnlyRootFilesystem": True,
                  "capabilities": {"drop": ["ALL"], "add": ["CHOWN", "FOWNER"]},
              },
              "command": ["sh", "-c"],
              "args": [SPARK_DIRECT_HOME_SCRIPT],
              "volumeMounts": [
                  {"name": "digitafrica-workshop-state", "mountPath": "/state", "readOnly": True},
                  {"name": "home", "mountPath": "/home/jovyan"},
              ],
          })
          containers.append({
              "name": SPARK_DIRECT_INIT, "image": image,
              "securityContext": {
                  "runAsUser": 1000, "runAsGroup": 100, "runAsNonRoot": True,
                  "allowPrivilegeEscalation": False, "readOnlyRootFilesystem": True,
                  "capabilities": {"drop": ["ALL"]},
              },
              "command": ["python3", "-c", SPARK_DIRECT_BOOTSTRAP],
              "env": [
                  {"name": "GROUP_ID", "value": group_id},
                  {"name": "DIGITAFRICA_SPARK_EXPECTED_NODE", "value": node},
                  {"name": "DIGITAFRICA_SPARK_POD_NODE",
                   "valueFrom": {"fieldRef": {"fieldPath": "spec.nodeName"}}},
                  {"name": "PYTHONDONTWRITEBYTECODE", "value": "1"},
              ],
              "volumeMounts": [
                  {"name": "home", "mountPath": "/home/jovyan"},
                  {"name": "digitafrica-workshop-state", "mountPath": "/state", "readOnly": True},
                  {"name": SPARK_DIRECT_SOURCE, "mountPath": "/run/spark-direct-source", "readOnly": True},
                  {"name": SPARK_DIRECT_CODE, "mountPath": "/run/spark-direct-code", "readOnly": True},
              ],
          })
          spawner.volumes = volumes
          spawner.init_containers = containers

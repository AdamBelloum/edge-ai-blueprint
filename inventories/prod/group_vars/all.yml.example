# Common
timezone: "Europe/Amsterdam"


tier0:
  k3s_mode: "none"   # none|agent|single
  expose_mode: "ingress"      # nodeport|ingress  (set to nodeport to fall back to NodePort)
  notebook_port: 8888 # port for local jupyter books to expose
  jupyter_nodeport: 30888 # port to expose if not using ingress
  modelcache_nodeport: 30080 #port to expose if not using ingress
  notebook_user: "digitafrica"
  notebook_dir: "/opt/digitafrica/notebooks"
  notebook_password: "CHANGE_ME"
  notebook_password_hash: "CHANGE_ME_GENERATE_A_NEW_ARGON2_HASH"
  enable_modelcache: true
  digitafrica_namespace: "digitafrica"
  # k3s config for tier0's single node cluster (mode=single)
  k3s_version: "v1.30.4+k3s1"
  # Used only when k3s_mode=agent - tier0 joins this tier1 server
  k3s_agent_server_host: "digitafrica-edge-node1"
  k3s_agent_version: "v1.30.4+k3s1"
  monitoring:
    node_exporter_port: 9100
    cadvisor_port: 8080

tier1:
  expose_mode: "ingress"   # ingress = deploy Traefik Ingress | nodeport = no Traefik, services use NodePort
  tls_mode: "selfsigned"   # selfsigned | letsencrypt | provided | none  (ignored when expose_mode=nodeport)
  # tls_cert_dir: "/path/to/local/certs"   # only when tls_mode=provided - local dir containing tls.crt and tls.key
  # tls_acme_email: "admin@example.com"    # only when tls_mode=letsencrypt
  k3s_version: "v1.30.4+k3s1"
  k3s_server_host: "digitafrica-edge-node1"
  k3s_cluster_cidr: "10.42.0.0/16"
  k3s_service_cidr: "10.43.0.0/16"
  digitafrica_namespace: "digitafrica"

  jupyterhub:
    jupyter_nodeport: 30888
    jupyterhub_http_port: 8000
    jupyterhub_admin_users: ["admin"]
    jupyterhub_public_url: "https://145.100.135.209/jupyter"
    storage_class: "local-path"   # switch to your NFS class (e.g. nfs-client) for multi-node freedom

  mlflow:
    enabled: false         # not tested yet
    mlflow_port: 5000
    mlflow_backend_store: "/opt/digitafrica/mlflow/backend"   # sqlite by default
    mlflow_artifact_root: "/opt/digitafrica/mlflow/artifacts" # local FS
    mlflow_auth: false  # not tested yet
  grafana_enabled: false   # not tested yet

# OIDC / Keycloak
# Required for participant-facing workshop deployments. Configure the realm and
# JupyterHub client through the deployed user portal, then set
# `oidc_enabled: true` in the ignored local all.yml.
# Keycloak must emit the participant's workshop membership in the `groups`
# claim, including exactly one of group_01 through group_N.
oidc:
  oidc_enabled: false
  oidc_issuer_url: "https://ab-01.lab.uvalight.net/keycloak/realms/<portal-managed-realm>"
  oidc_client_id: "<portal-managed-jupyterhub-client-id>"
  oidc_client_secret: "<set-only-in-local-all.yml>"
  oidc_scope:
    - "openid"
    - "profile"
    - "email"
  oidc_username_claim: "preferred_username"
  oidc_groups_claim: "groups"
  oidc_tls_verify: true

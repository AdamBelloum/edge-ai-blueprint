# Workshop release record. Copy to workshop-release.env and complete every
# value before running the readiness wizard. Keep the completed file outside
# version control in a controlled experiment-record location.

# Immutable commit of edge-ai-blueprint that was deployed by Ansible.
EDGE_AI_BLUEPRINT_REF=REPLACE_WITH_COMMITTED_GIT_SHA

# Address as seen from Silo pods. Do not use localhost unless the Flower server
# is inside the same pod.
FLOWER_SERVER_ADDRESS=145.100.135.209:8080

# Deployment evidence. Record checksums from the deployed runtime evidence.
RUNTIME_REQUIREMENTS_SHA256=REPLACE_WITH_REQUIREMENTS_LOCK_SHA256
PARTITION_MANIFEST_SHA256=REPLACE_WITH_PARTITION_MANIFEST_SHA256
PARTITION_01_SHA256=REPLACE_WITH_GROUP_01_PARTITION_SHA256
PARTITION_02_SHA256=REPLACE_WITH_GROUP_02_PARTITION_SHA256

# Required public citation or stable authoritative dataset URL.
DATASET_CITATION_URL=https://www.kaggle.com/competitions/cassava-leaf-disease-classification/data

# workflow_demo is required for the current client implementation because it
# generates synthetic features and uses only CSV labels. validated_model is
# reserved for a client that loads genuine research features/images.
EXPERIMENT_MODE=workflow_demo

# Expected Flower configuration.
MIN_CLIENTS=2
NUM_ROUNDS=5
